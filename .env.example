# Option 1: Nebius Token Factory (required for hackathon submission)
# Get your key from https://tokenfactory.nebius.com
NEBIUS_API_KEY=

# Option 2: NVIDIA API (free tier for development)
# Get your key from https://build.nvidia.com (sign in, click "Get API Key")
NVIDIA_API_KEY=

# Set one or both. Nebius is used if both are set.
